# Variables d'environnement — Backend
# Copiez ce fichier en .env et remplissez les valeurs

# URL de votre base de données (ex: PostgreSQL sur Railway, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/sweetmanager"

# Clé secrète pour les JWT (générez une longue chaîne aléatoire)
JWT_SECRET="CHANGE_ME_WITH_A_VERY_LONG_RANDOM_SECRET"

# Port d'écoute du serveur (Render/Railway le définissent automatiquement)
PORT=5000

# URL du frontend (utilisée pour CORS)
# En production : l'URL de votre app déployée (ex: https://sweetmanager.onrender.com)
# En développement : http://localhost:5173
FRONTEND_URL="http://localhost:5173"
